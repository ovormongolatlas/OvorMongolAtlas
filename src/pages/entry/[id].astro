---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatYearRange } from '../../lib/dates';

export async function getStaticPaths() {
	const entries = await getCollection('entries');
	return entries.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const years = formatYearRange(
	entry.data.startYear,
	entry.data.endYear,
	entry.data.yearType,
	entry.data.altStartYear,
	entry.data.altEndYear,
);
---

<Layout>
	<main>
		<p><a href="/entries">← All entries</a></p>
		<h1>{entry.data.title}</h1>
		<p class="meta"><span class="entry-type">{entry.data.type}</span>{years && <> · {years}</>}</p>
		<p class="summary">{entry.data.summary}</p>
		{entry.data.images && entry.data.images.length > 0 && (
			<div class="images">
				{entry.data.images.map((image) => (
					<figure>
						<img src={image.src} alt={image.alt} loading="lazy" />
						<figcaption>
							{image.caption && <><strong>{image.caption}.</strong> </>}
							{image.photographer && <>Photographer: {image.photographer}. </>}
							{image.depicted && <>Depicted: {image.depicted}. </>}
							{image.date && <>Date: {image.date}. </>}
							{image.venue && <>Venue: {image.venue}. </>}
							{image.collection && <>Collection: {image.collection}. </>}
							{image.institution && <>Institution: {image.institution}. </>}
							{image.shelfmark && <>Shelfmark: {image.shelfmark}. </>}
							{image.license && (
								<>
									License: {image.licenseUrl ? <a href={image.licenseUrl}>{image.license}</a> : image.license}.{' '}
								</>
							)}
							{image.source && <>Source: {image.source}. </>}
							{image.note && <span class="image-note">{image.note}</span>}
						</figcaption>
					</figure>
				))}
			</div>
		)}
		<Content />
	</main>
</Layout>

<style>
	main {
		max-width: 60ch;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		font-family: system-ui, sans-serif;
	}

	h1 {
		font-size: 2rem;
		margin-bottom: 0.25rem;
	}

	.meta {
		color: #777;
		margin-top: 0;
	}

	.entry-type {
		text-transform: capitalize;
	}

	.summary {
		font-size: 1.1rem;
		color: #444;
	}

	.images {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 1.5rem 0 2rem;
	}

	.images figure {
		margin: 0;
		max-width: 320px;
		flex: 1 1 260px;
	}

	.images img {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid #ddd;
	}

	.images figcaption {
		font-size: 0.8rem;
		color: #555;
		margin-top: 0.4rem;
		line-height: 1.4;
	}

	.images figcaption a {
		color: inherit;
	}

	.image-note {
		display: block;
		margin-top: 0.3rem;
		font-style: italic;
	}
</style>
