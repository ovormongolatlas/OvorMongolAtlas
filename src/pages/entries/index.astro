---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatYearRange } from '../../lib/dates';

const allEntries = await getCollection('entries');

const typeOrder = ['person', 'place', 'group', 'battle', 'state', 'theme'] as const;
const typeLabels: Record<(typeof typeOrder)[number], string> = {
	person: 'People',
	place: 'Places',
	group: 'Groups',
	battle: 'Battles',
	state: 'States',
	theme: 'Themes',
};

type Entry = (typeof allEntries)[number];

// Theme entries have no startYear, so this falls back to 0 for them; harmless
// since it only affects ordering within a group, and themes sort together.
function byStartYear(a: Entry, b: Entry): number {
	return (a.data.startYear ?? 0) - (b.data.startYear ?? 0);
}

function childrenOf(entry: Entry): Entry[] {
	return allEntries.filter((e) => e.data.partOf === entry.id).sort(byStartYear);
}

const groups = typeOrder
	.map((type) => ({
		type,
		label: typeLabels[type],
		// Entries that are a partOf another entry (e.g. Mengjiang's successive
		// governments) are nested under their parent below, not listed as flat peers.
		items: allEntries.filter((entry) => entry.data.type === type && !entry.data.partOf).sort(byStartYear),
	}))
	.filter((group) => group.items.length > 0);
---

<Layout title="Entries">
	<main class="page-narrow">
		<header class="card index-head">
			<p class="overline">Övör Mongol Atlas</p>
			<h1>Entries</h1>
			<p class="lead">{allEntries.length} entries on the people, places, groups, states and themes of Inner Mongolia, 1890–1950.</p>
			<div class="search">
				<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.8l-.3-.3A6.5 6.5 0 1 0 9.5 16a6.5 6.5 0 0 0 4.2-1.6l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"></path></svg>
				<input type="search" id="search-input" placeholder="Search entries by title or summary" aria-label="Search entries" />
			</div>
			<ul id="search-results"></ul>
			<nav class="jump" aria-label="Entry types">
				{groups.map((group) => <a href={`#${group.type}`} style={`--type:var(--type-${group.type})`}>{group.label} <span>{allEntries.filter((e) => e.data.type === group.type).length}</span></a>)}
			</nav>
		</header>
		{groups.map((group) => (
			<section class="card group" id={group.type} style={`--type:var(--type-${group.type})`}>
				<h2 class="overline">{group.label}</h2>
				<ul class="entry-list">
					{group.items.map((entry) => {
						const children = childrenOf(entry);
						const years = formatYearRange(
							entry.data.startYear,
							entry.data.endYear,
							entry.data.yearType,
							entry.data.altStartYear,
							entry.data.altEndYear,
						);
						return (
							<li>
								<a class="row" href={`/entry/${entry.id}`}>
									<span class="row-title">{entry.data.title}{years && <span class="years"> {years}</span>}</span>
									<span class="row-summary">{entry.data.summary}</span>
								</a>
								{children.length > 0 && (
									<ul class="substages" aria-label={`Successive stages of ${entry.data.title}`}>
										{children.map((child) => {
											const childYears = formatYearRange(
												child.data.startYear,
												child.data.endYear,
												child.data.yearType,
												child.data.altStartYear,
												child.data.altEndYear,
											);
											return (
												<li>
													<a class="row" href={`/entry/${child.id}`}>
														<span class="row-title">{child.data.title}{childYears && <span class="years"> {childYears}</span>}</span>
													</a>
												</li>
											);
										})}
									</ul>
								)}
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</main>
</Layout>

<script>
	import Fuse from 'fuse.js';

	type IndexEntry = { id: string; title: string; type: string; summary: string };

	const input = document.getElementById('search-input') as HTMLInputElement;
	const results = document.getElementById('search-results') as HTMLUListElement;

	if (location.hash === '#search-input') {
		input.focus();
	}

	const response = await fetch('/search-index.json');
	const entries: IndexEntry[] = await response.json();

	const fuse = new Fuse(entries, {
		keys: ['title', 'summary'],
		threshold: 0.35,
	});

	input.addEventListener('input', () => {
		const query = input.value.trim();
		results.innerHTML = '';

		if (!query) return;

		const matches = fuse.search(query).slice(0, 8);
		for (const { item } of matches) {
			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `/entry/${item.id}`;
			a.textContent = item.title;
			li.appendChild(a);
			const type = document.createElement('span');
			type.className = 'result-type';
			type.textContent = ` ${item.type}`;
			li.appendChild(type);
			results.appendChild(li);
		}

		if (matches.length === 0) {
			const li = document.createElement('li');
			li.textContent = 'No matches.';
			li.className = 'result-type';
			results.appendChild(li);
		}
	});
</script>

<style>
	.index-head {
		padding: 1.75rem 2rem 1.25rem;
	}

	h1 {
		margin: 0.3rem 0 0.25rem;
		font-size: 2.2rem;
		font-weight: 400;
	}

	.lead {
		margin: 0 0 1.25rem;
		color: var(--muted);
	}

	.search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0 0.75rem;
		border-radius: 2px;
		background: #f1f3f4;
		color: var(--muted);
		border-bottom: 2px solid transparent;
	}

	.search:focus-within {
		background: #fff;
		box-shadow: var(--shadow-1);
		border-bottom-color: var(--primary);
	}

	.search input {
		flex: 1;
		min-width: 0;
		padding: 0.8rem 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 1rem;
		color: var(--text);
		outline: none;
	}

	#search-results {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
	}

	#search-results:empty {
		display: none;
	}

	#search-results :global(li) {
		padding: 0.45rem 0.25rem;
		border-bottom: 1px solid var(--divider);
	}

	#search-results :global(.result-type) {
		margin-left: 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.jump a {
		padding: 0.3rem 0.8rem;
		border-radius: 16px;
		border: 1px solid var(--divider);
		font-size: 0.85rem;
		text-decoration: none;
		color: var(--type);
	}

	.jump a:hover {
		background: #f5f5f5;
	}

	.jump span {
		color: var(--muted);
	}

	.group {
		margin-top: 1rem;
		padding: 1.1rem 0 0.5rem;
		border-top: 3px solid var(--type);
		scroll-margin-top: 1rem;
	}

	.group h2 {
		padding: 0 1.5rem 0.5rem;
		color: var(--type);
	}

	.entry-list,
	.substages {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.entry-list > li + li {
		border-top: 1px solid #eeeeee;
	}

	.row {
		display: block;
		padding: 0.7rem 1.5rem;
		text-decoration: none;
		color: var(--text);
	}

	.row:hover {
		background: #f5f5f5;
		color: var(--text);
	}

	.row-title {
		display: block;
		font-weight: 500;
		color: var(--primary);
	}

	.years {
		margin-left: 0.35rem;
		font-weight: 400;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.row-summary {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-top: 0.15rem;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--muted);
	}

	.substages {
		margin: -0.35rem 0 0.5rem 1.5rem;
		border-left: 2px solid var(--divider);
	}

	.substages .row {
		padding: 0.35rem 1rem;
	}

	.substages .row-title {
		font-size: 0.95rem;
	}

	@media (max-width: 600px) {
		.index-head {
			padding: 1.25rem;
		}

		.row,
		.group h2 {
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}
</style>
